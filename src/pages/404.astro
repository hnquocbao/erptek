---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Not on the shelf | ERPTEK">
  <Header />
  <main id="main" class="wrap lost">
    <p class="lost__code">Location not found</p>
    <h1>This bin is empty.</h1>
    <p>The page you were looking for has moved or never existed.</p>
    <a class="btn btn--yellow" href="/">Back to the home page</a>
  </main>
  <Footer />
</Base>
<style>
  .lost { display: grid; gap: 1.25rem; justify-items: start; padding-block: 6rem; min-height: 60vh; }
  .lost__code { font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); }
  h1 { font-size: var(--step-4); text-transform: uppercase; font-weight: 900; }
</style>
