---
// The home page, shared by every language route.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Hero from '../Hero.astro';
import Aisles from '../Aisles.astro';
import Principle from '../Principle.astro';
import Method from '../Method.astro';
import Readiness from '../Readiness.astro';
import Faq from '../Faq.astro';
import BookCall from '../BookCall.astro';
import Footer from '../Footer.astro';
import type { Lang } from '../../i18n/copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} alternates>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Aisles lang={lang} />
    <Principle lang={lang} />
    <Method lang={lang} />
    <Readiness lang={lang} />
    <Faq lang={lang} />
    <BookCall lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
<script>
  import { initBookingForms } from '../../scripts/booking';
  initBookingForms();
</script>
