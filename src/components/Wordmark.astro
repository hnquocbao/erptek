---
// ERPTEK wordmark set as a thermal shelf label with a decorative barcode.
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
const bars = [2,1,1,3,1,2,1,1,2,3,1,1,2,1,3,1,1,2];
let x = 0;
const rects = bars.map((w, i) => { const r = { x, w, on: i % 2 === 0 }; x += w; return r; });
---
<span class:list={['mark', `mark--${size}`]}>
  <span class="mark__name">ERPTEK</span>
  <svg class="mark__bars" viewBox={`0 0 ${x} 10`} preserveAspectRatio="none" aria-hidden="true">
    {rects.filter((r) => r.on).map((r) => <rect x={r.x} y="0" width={r.w} height="10" />)}
  </svg>
</span>
<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.6rem 0.25rem;
    background: var(--label);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-label);
    color: var(--ink);
  }
  .mark__name {
    font-family: var(--font-stencil);
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .mark__bars {
    width: 2.1rem;
    height: 1.1rem;
    fill: var(--ink);
  }
  .mark--lg .mark__name { font-size: 2.2rem; }
  .mark--lg .mark__bars { width: 3rem; height: 1.6rem; }
</style>
