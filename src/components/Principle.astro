---
import { copy, type Lang } from '../i18n/copy';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].principle;
---
<section class="principle" aria-labelledby="principle-title">
  <div class="wrap principle__grid">
    <h2 id="principle-title">{t.title}</h2>
    <div class="principle__pair">
      <div class="side side--bad">
        <h3>{t.badTitle}</h3>
        <p>{t.bad}</p>
      </div>
      <div class="side side--good">
        <h3>{t.goodTitle}</h3>
        <p>{t.good}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .principle {
    padding-block: var(--space-xl);
  }
  .principle__grid {
    display: grid;
    gap: var(--space-l);
  }
  h2 {
    font-family: var(--font-stencil);
    font-size: var(--step-4);
    text-transform: uppercase;
    max-width: 18ch;
    line-height: 0.92;
  }
  .principle__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    max-width: 62rem;
  }
  .side {
    display: grid;
    gap: 0.6rem;
    padding-top: var(--space-s);
    border-top: 3px solid var(--ink);
  }
  .side--bad {
    border-top-style: dashed;
    color: var(--ink-soft);
  }
  .side h3 {
    font-size: var(--step-1);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .side p {
    max-width: 44ch;
  }
  @media (max-width: 44rem) {
    .principle__pair {
      grid-template-columns: 1fr;
    }
  }
</style>
