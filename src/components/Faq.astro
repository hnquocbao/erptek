---
import { copy, type Lang } from '../i18n/copy';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].faq;
---
<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 id="faq-title">{t.title}</h2>
    <div class="faq__list">
      {t.items.map((f) => (
        <details>
          <summary>
            <span>{f.q}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq {
    padding-block: var(--space-xl);
    background: var(--concrete-deep);
    border-top: 2px solid var(--ink);
  }
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-l);
    align-items: start;
  }
  h2 {
    font-size: var(--step-3);
    text-transform: uppercase;
  }
  details {
    border-bottom: 2px solid var(--ink);
  }
  details:first-child {
    border-top: 2px solid var(--ink);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    padding: 1.1rem 0 1rem;
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--yellow-deep);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  summary svg {
    flex: none;
    width: 1.25rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    transition: transform 200ms var(--ease-out);
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  details p {
    padding-bottom: 1.25rem;
    max-width: 65ch;
    color: var(--ink-soft);
  }
  @media (max-width: 52rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
