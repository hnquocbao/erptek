---
import Wordmark from './Wordmark.astro';
import { copy, homePath, langs, type Lang } from '../i18n/copy';
interface Props { lang: Lang; switchTo?: Partial<Record<Lang, string>>; linkBase?: string }
const { lang, switchTo = homePath, linkBase = '' } = Astro.props;
const t = copy[lang];
const links = [
  { href: `${linkBase}#services`, label: t.nav.services },
  { href: `${linkBase}#method`, label: t.nav.method },
  { href: `${linkBase}#readiness`, label: t.nav.readiness },
  { href: `${linkBase}#faq`, label: t.nav.faq },
];
const names: Record<Lang, { short: string; full: string }> = {
  en: { short: 'EN', full: 'English' },
  vi: { short: 'VI', full: 'Tiếng Việt' },
};
---
<header class="top">
  <div class="wrap top__inner">
    <a href={homePath[lang]} class="top__home" aria-label={t.nav.home}><Wordmark /></a>
    <nav aria-label={t.nav.label}>
      <ul class="top__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <nav class="langs" aria-label={t.langSwitch.label}>
      {langs.map((l) => (
        <a
          href={switchTo[l] ?? homePath[l]}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'page' : undefined}
          title={names[l].full}
        ><span aria-hidden="true">{names[l].short}</span><span class="visually-hidden">{names[l].full}</span></a>
      ))}
    </nav>
    <a class="btn btn--yellow top__cta" href={`${linkBase}#book`}>{t.nav.book}</a>
  </div>
  <div class="top__beam" aria-hidden="true"></div>
</header>
<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--concrete) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  .top__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.25rem;
  }
  .top__home {
    text-decoration: none;
    flex: none;
  }
  nav:first-of-type {
    margin-left: auto;
  }
  /* Language switch: a two-cell shelf label. */
  .langs {
    display: flex;
    flex: none;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--label);
    overflow: hidden;
  }
  .langs a {
    display: block;
    padding: 0.4rem 0.55rem 0.3rem;
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .langs a + a {
    border-left: 2px solid var(--ink);
  }
  .langs a:hover {
    background: var(--concrete-deep);
  }
  .langs a[aria-current='page'] {
    background: var(--ink);
    color: var(--label);
  }
  .top__links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top__links a {
    display: block;
    padding: 0.5rem 0.75rem 0.4rem;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .top__links a:hover {
    background: var(--concrete-deep);
  }
  .top__cta {
    white-space: nowrap;
    min-height: 2.6rem;
    padding-block: 0.5rem 0.4rem;
    font-size: 1.05rem;
  }
  /* Yellow floor tape the whole site starts from. */
  .top__beam {
    height: 8px;
    background: var(--yellow);
    border-block: 2px solid var(--ink);
  }
  @media (max-width: 64rem) {
    nav:first-of-type { display: none; }
    .langs { margin-left: auto; }
  }
  @media (max-width: 24rem) {
    .top__inner { gap: 0.6rem; }
    .top__cta { padding-inline: 0.8rem; font-size: 0.95rem; }
  }
</style>
