# Where the booking forms POST (JSON). Formspree, Basin, a Cloudflare Worker, etc.
# Leave empty to fall back to opening the visitor's email client.
PUBLIC_FORM_ENDPOINT=
# Address used for the email fallback and shown in the footer.
PUBLIC_CONTACT_EMAIL=hello@erptek.net
# Cloudflare Turnstile site key (public). Leave empty to disable the captcha.
# Test key that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
