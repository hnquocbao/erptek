# Build-time settings. Copy to .env for local work; full guide: docs/SETUP.md
#
# Google Apps Script web app URL (ends in /exec) that saves leads to the
# "ERPTEK leads" sheet and emails you. Empty = forms open an email draft.
PUBLIC_FORM_ENDPOINT=
# Cloudflare Turnstile site key (public). Empty = no captcha.
# Test key that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Public contact address shown on the site and used for the email fallback.
PUBLIC_CONTACT_EMAIL=hello@erptek.net
