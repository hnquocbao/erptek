# Caddy config for erptek.net. Installed to /etc/caddy/Caddyfile by deploy/setup-vps.sh.
# Caddy gets and renews the HTTPS certificates automatically once DNS points here.

erptek.net {
	root * /var/www/erptek/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Astro's hashed build assets never change, so cache them for a year.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}

www.erptek.net {
	redir https://erptek.net{uri} permanent
}
